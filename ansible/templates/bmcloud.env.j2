# bmcloud-server configuration. Loaded by the systemd unit via EnvironmentFile=.
# systemd format: KEY=value, no quotes, no export.

# Listen on localhost only - the app is reachable from outside through nginx.
BMCLOUD_BIND_ADDR=127.0.0.1:3000

# Absolute path to the database (the data directory is created by the playbook).
BMCLOUD_DB_PATH={{ app_root }}/data/bmcloud.db
